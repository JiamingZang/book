": "rectangle", "x": 79.2, "y": 570.0, "width": 179.2, "height": 64.0, "angle": 0, "strokeColor": "#26a69a", "backgroundColor": "#e8f5e9", "fillStyle": "hachure", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 3607, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [{"id": "e0015", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "e0015", "type": "text", "x": 87.2, "y": 578.0, "width": 163.2, "height": 48.0, "angle": 0, "strokeColor": "#263238", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 63303, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 17.099999999999998, "fontFamily": 1, "text": "测试成功：缺口升级\n= 测量缺口（MG）\n预期同向第二波", "textAlign": "center", "verticalAlign": "middle", "containerId": "e0014", "originalText": "测试成功：缺口升级\n= 测量缺口（MG）\n预期同向第二波", "lineHeight": 1.3, "baseline": 15.389999999999999}, {"id": "e0016", "type": "arrow", "x": 456.8, "y": 512.4, "width": 102.40000000000003, "height": 51.200000000000045, "angle": 0, "strokeColor": "#ef5350", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2.0, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 48745, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "points": [[456.8, 512.4], [559.2, 563.6]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "e0017", "type": "text", "x": 499.40000000000003, "y": 534.8, "width": 68.39999999999999, "height": 23.084999999999997, "angle": 0, "strokeColor": "#ef5350", "backgroundColor": 